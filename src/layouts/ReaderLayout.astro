---
// ReaderLayout（reader-shell.md）：读者端全部页面共用的外壳——SiteHeader + 主体 + BackLink + SiteFooter
import BackLink from "../components/reader/BackLink.astro";
import SiteFooter from "../components/reader/SiteFooter.astro";
import SiteHeader from "../components/reader/SiteHeader.astro";
import type { NavCurrent } from "../lib/reader/nav";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  current?: NavCurrent;
  back?: string; // `> cd ..` 的目标；首页不传
  clipX?: boolean; // 主体横向裁切（overflow-x: clip，不形成滚动容器）：书影音分类导航 GooeyNav 画布外扩 72px，手机上会撑出横向滚动
  width?: "narrow" | "list" | "wide" | "full"; // 主体版心：首页 640、列表 896、详情三栏 1338；full 满宽，左右 50（手机 20），与 SiteHeader 对齐
}
const { title, description, current, back, width = "list", clipX = false } = Astro.props;
const widths = { narrow: "max-w-[640px]", list: "max-w-[896px]", wide: "max-w-[1338px]", full: "md:px-[50px]" };
---

<BaseLayout title={title} description={description}>
  <SiteHeader current={current} />
  <slot name="before-main" />
  <main class:list={["mx-auto w-full px-5 pt-14 pb-20 max-md:pt-8", widths[width], clipX && "overflow-x-clip"]}>
    <slot />
    {
      back && (
        <div class="pt-10">
          <BackLink href={back} />
        </div>
      )
    }
  </main>
  <SiteFooter />
</BaseLayout>
