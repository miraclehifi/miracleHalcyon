---
// SiteFooter（components.md"读者端区块"）：站点名、签名一句话、版权、RSS / GitHub
import { site } from "../../config/site";

const year = new Date().getFullYear();
const link = "border-b border-transparent transition-colors duration-200 hover:border-current hover:text-ink";
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-2 px-[50px] pt-8 pb-12 max-md:px-5">
    <p class="text-ui font-semibold text-ink">miracleHalcyon</p>
    <p class="text-meta text-ink-muted">{site.footerTagline}</p>
    <p class="flex flex-wrap items-center gap-x-2 text-caption text-ink-faint">
      <span>© {year} miracleHalcyon</span>
      <span aria-hidden="true">·</span>
      <a href="/rss.xml" class={link}>RSS</a>
      {
        site.github && (
          <>
            <span aria-hidden="true">·</span>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class={link}>
              GitHub
            </a>
          </>
        )
      }
    </p>
  </div>
</footer>
