---
// ThemeToggle（reader-shell.md"主题切换"、ADR-008）：原生脚本，不加载 React；图标固定为半填充圆，名称由脚本按当前配色设置
---

<button
  type="button"
  data-theme-toggle
  aria-label="主题：切换"
  class="inline-flex size-8 cursor-pointer items-center justify-center rounded-control text-ink-muted transition-colors duration-200 hover:bg-surface-sunken hover:text-ink max-md:size-11"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
    <path d="M12 3l0 18"></path>
    <path d="M12 9l4.65 -4.65"></path>
    <path d="M12 14.3l7.37 -7.37"></path>
    <path d="M12 19.6l8.85 -8.85"></path>
  </svg>
</button>

<script>
  import { bindThemeToggle } from "../../lib/reader/theme-toggle";

  for (const button of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) bindThemeToggle(button);
</script>
