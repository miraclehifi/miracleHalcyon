---
// ThemeToggle（reader-shell.md"主题切换"）：三态轮换的交互在 add-theme-toggle 实现；此处先输出按钮骨架
import { SunMoon } from "lucide-react";
---

<button
  type="button"
  data-theme-toggle
  data-mode="system"
  aria-label="主题：跟随系统"
  class="inline-flex size-8 items-center justify-center rounded-control text-ink-muted transition-colors duration-200 hover:bg-surface-sunken hover:text-ink max-md:size-11"
>
  <SunMoon size={18} aria-hidden="true" />
</button>
