---
// ThemeToggle（reader-shell.md"主题切换"、ADR-008）：原生脚本，不加载 React；三态图标按 data-mode 显示
import { Moon, Sun, SunMoon } from "lucide-react";
---

<button
  type="button"
  data-theme-toggle
  data-mode="system"
  aria-label="主题：跟随系统"
  class="group inline-flex size-8 cursor-pointer items-center justify-center rounded-control text-ink-muted transition-colors duration-200 hover:bg-surface-sunken hover:text-ink max-md:size-11"
>
  <Sun size={18} aria-hidden="true" className="hidden group-data-[mode=light]:block" />
  <Moon size={18} aria-hidden="true" className="hidden group-data-[mode=dark]:block" />
  <SunMoon size={18} aria-hidden="true" className="hidden group-data-[mode=system]:block" />
</button>

<script>
  import { bindThemeToggle } from "../../lib/reader/theme-toggle";

  for (const button of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) bindThemeToggle(button);
</script>
