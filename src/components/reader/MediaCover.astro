---
// 书影音封面（reader-media.md"条目"）：2:3 居中裁切；无封面或加载失败显示 surface-sunken 底 + image-off 图标（role="img"）。
// 失败切换用 <img onerror> 一行内联处理（读者页不引入框架）；尺寸与定位（relative / absolute）由调用方 class 决定，占位与图片同尺寸
import { ImageOff } from "lucide-react";

interface Props {
  src: string | null;
  class?: string;
  iconSize?: number;
}
const { src, class: className, iconSize = 16 } = Astro.props;
---

<div class:list={["shrink-0 overflow-hidden bg-surface-sunken", className]}>
  {src && <img src={src} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" onerror="this.nextElementSibling.hidden=false;this.remove()" />}
  <div role="img" aria-label="图片不可用" class="absolute inset-0 flex items-center justify-center text-ink-faint" hidden={src ? true : undefined}>
    <ImageOff size={iconSize} aria-hidden="true" />
  </div>
</div>
