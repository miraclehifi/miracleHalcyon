---
// MediaList（components.md，reader-media.md"MediaList"）：所有分类都是 MediaPosterWall 岛（media-wall-all-types）；
// 空分类显示 EmptyState（无按钮，图标按分类；不挂岛，也就没有"按时间"按钮）
import { EmptyState } from "../ui/EmptyState";
import type { IconName } from "../ui/icons";
import { TYPE_LABELS, type ShelfPublicEntry, type ShelfType } from "../../domains/shelf/entry";
import { emptyIcon } from "../../lib/reader/shelf";
import { MediaPosterWall } from "./MediaPosterWall";

interface Props {
  type: ShelfType;
  entries: ShelfPublicEntry[];
}
const { type, entries } = Astro.props;
// 海报墙不显示作者 / 导演 / 开发商：岛的 props 会序列化进 HTML，先去掉
const posterEntries = entries.map((entry) => ({ ...entry, creator: null }));
---

{
  entries.length === 0 ? (
    <EmptyState icon={emptyIcon(type) as IconName} title={`还没有记录${TYPE_LABELS[type]}`} />
  ) : (
    <MediaPosterWall client:load entries={posterEntries} />
  )
}
