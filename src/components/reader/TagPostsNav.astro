---
// TagPostsNav（components.md"页面区块"、reader-post-detail.md"左栏"）：同标签文章。
// variant="aside"：≥ 1280px 的左栏（sticky）；variant="end"（TagPostsNav/Mobile）：< 1280px 时在文末，每项高 44
import type { RelatedPost } from "../../lib/reader/related";

interface Props {
  items: RelatedPost[];
  variant: "aside" | "end";
}
const { items, variant } = Astro.props;
---

{
  items.length > 0 &&
    (variant === "aside" ? (
      <nav aria-label="同标签文章" class="sticky top-6 flex w-[190px] shrink-0 flex-col gap-3 self-start pt-[120px] max-xl:hidden">
        <p class="text-meta text-ink-faint">同标签文章</p>
        <ul class="flex flex-col gap-3">
          {items.map(({ post, sharedTags }) => (
            <li>
              <a href={`/posts/${post.slug}`} class="group flex flex-col gap-0.5">
                <span class="line-clamp-2 text-ui text-ink-muted transition-colors duration-200 group-hover:text-accent">{post.title}</span>
                <span class="font-mono text-caption text-ink-faint">{sharedTags.map((tag) => `#${tag}`).join(" ")}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <nav aria-label="同标签文章" class="flex flex-col gap-1 border-t border-line pt-5 xl:hidden">
        <p class="pb-2 text-meta text-ink-faint">同标签文章</p>
        <ul class="flex flex-col">
          {items.map(({ post }) => (
            <li>
              <a href={`/posts/${post.slug}`} class="flex min-h-11 items-center py-2.5 text-[15px] text-ink-muted transition-colors duration-200 hover:text-accent">
                {post.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))
}
