---
// TableOfContents（components.md"页面区块"、reader-post-detail.md"右栏"）：≥ 1280px 右栏（sticky）——
// 阅读进度百分比 + 进度条 + 目录（h2 / h3）；当前章节由 reading.ts 标 aria-current；无标题时只显示进度
import type { TocItem } from "../../lib/reader/types";

interface Props {
  toc: TocItem[];
}
const { toc } = Astro.props;
---

<div class="sticky top-6 flex flex-col gap-4 pt-[120px]">
  <div role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-reading-progress class="flex flex-col gap-2">
    <span data-reading-label class="text-meta text-ink-faint tabular-nums">已读 0%</span>
    <span class="relative block h-0.5 bg-line">
      <span class="absolute inset-y-0 left-0 w-(--reading-progress,0%) bg-accent"></span>
    </span>
  </div>
  {
    toc.length > 0 && (
      <nav aria-label="目录" class="pt-2">
        <ul class="flex flex-col gap-2.5">
          {toc.map((item) => (
            <li class:list={[item.depth === 3 && "pl-3.5"]}>
              <a
                href={`#${item.id}`}
                data-toc-link={item.id}
                class:list={[
                  "block transition-colors duration-200 hover:text-accent aria-[current=true]:font-semibold aria-[current=true]:text-accent",
                  item.depth === 2 ? "text-ui text-ink-muted" : "text-meta text-ink-faint",
                ]}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</div>
