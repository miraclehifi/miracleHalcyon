                      "name": "Text",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "博客这件事，我断断续续做了好几年。每次都是兴冲冲地选框架、调样式，写了三五篇就搁下了。",
                      "lineHeight": 1.8,
                      "fontFamily": "$font-prose",
                      "fontSize": 16,
                      "fontWeight": "normal",
                      "letterSpacing": 0.14
                    }
